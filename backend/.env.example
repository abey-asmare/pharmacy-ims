# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets (ODD 1.2 / SDD Table 2.7).

APP_NAME=Pharmacy IMS
ENV=development

DATABASE_URL=postgresql+psycopg2://pharmacy:pharmacy@localhost:5432/pharmacy_ims

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

INTERNAL_JOB_SECRET=replace-with-another-long-random-string

ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]